# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=messenger
DB_PASSWORD=nothing
DB_NAME=secure_messenger

# JWT
# REQUIRED — must be a long random string, minimum 32 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Argon2id parameters. These match the client's Argon2id parameters in
# client/src/crypto/kdf.py so both sides agree (above the OWASP minimums).
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Ethereum Sepolia integration. See contracts/DEPLOY.md for the full setup.
# All three must be set for chain writes; if any is missing, the backend
# logs a warning and leaves chain_status='pending' on every message.
#
# SEPOLIA_RPC_URL — any Sepolia JSON-RPC endpoint, e.g.:
#   https://ethereum-sepolia.publicnode.com
#   https://rpc.sepolia.org
#   https://eth-sepolia.g.alchemy.com/v2/<api-key>
# SEPOLIA_PRIVATE_KEY — the SERVER wallet's private key (not your personal
#   MetaMask). Generate with:
#   node -e "console.log(new (require('ethers')).Wallet.createRandom())"
#   Fund it from a Sepolia faucet, then run setRecorder(addr, true) on the
#   deployed contract to allow-list it. NEVER COMMIT THIS VALUE.
# CONTRACT_ADDRESS — the deployed MessageDigest address from Remix.
#   Falls back to contracts/deployments/sepolia.json#address if blank.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
CONTRACT_ADDRESS=

# CORS — REQUIRED in production (full origin URL, e.g. https://app.example.com)
ALLOWED_ORIGIN=

# Optional — where to write the error log file (default: logs/error.log).
# Parent directory will be created automatically.
ERROR_LOG_PATH=

# Optional — override log verbosity (error|warn|info|debug).
# Defaults to "info" in production and "debug" otherwise.
LOG_LEVEL=
