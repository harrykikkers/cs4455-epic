# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=messenger
DB_PASSWORD=nothing
DB_NAME=secure_messenger

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Argon2id parameters (OWASP recommended minimums)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Ethereum Sepolia, TO-DO LAST
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
CONTRACT_ADDRESS=

# TLS (for local dev — production uses reverse proxy)
# LetsEncrypt is to be used as is free for the certs

TLS_CERT_PATH=
TLS_KEY_PATH=
