# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=messenger
DB_PASSWORD=nothing
DB_NAME=secure_messenger

# JWT
# REQUIRED — must be a long random string, minimum 32 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Argon2id parameters (OWASP recommended minimums)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Ethereum Sepolia, FOR BLOCKCAHIN PART TO BE DONE TOWARDS END AS IS JUST HASHING MESSAGES AND SENDING
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
CONTRACT_ADDRESS=

# TLS (for local dev — production uses reverse proxy), LetsEncrypt is to be used for this
TLS_CERT_PATH=
TLS_KEY_PATH=

# CORS — REQUIRED in production (full origin URL, e.g. https://app.example.com)
ALLOWED_ORIGIN=

# Optional — where to write the error log file (default: logs/error.log).
# Parent directory will be created automatically.
ERROR_LOG_PATH=

# Optional — override log verbosity (error|warn|info|debug).
# Defaults to "info" in production and "debug" otherwise.
LOG_LEVEL=
