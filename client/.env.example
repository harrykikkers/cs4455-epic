# Backend server base URL.
# Must be https:// for any non-local host; http://localhost is allowed for
# local development.
SERVER_URL=http://localhost:3000

# Where the encrypted local keystore (private keys + pinned peer keys) lives.
KEYSTORE_PATH=~/.secure_messenger/keystore.json

# HTTP request timeout, in seconds.
REQUEST_TIMEOUT=10

# Python logging level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
